rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{emailDoc} {
      allow create: if emailDoc == request.resource.data.email
        && request.resource.data.keys().hasOnly(['email', 'source', 'country', 'countryCode', 'timezone', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'source', 'country', 'countryCode', 'timezone', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.source == 'taskpilot-website'
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 100
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 10
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
